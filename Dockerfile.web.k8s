FROM node:22-alpine AS build
WORKDIR /app
COPY web-app/package*.json ./
RUN npm install
COPY web-app/ .
ENV VITE_LOCATION_SERVICE_URL=/api/location
ENV VITE_EVENT_SERVICE_URL=/api/event
ENV VITE_NOTIFICATION_WS_URL=
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# nginx config mounted via K8s ConfigMap, not baked in
EXPOSE 8080
